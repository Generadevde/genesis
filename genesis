#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# genesis — o executável do Genesis. Abre direto na simulação, sem menus.
#
# Usa o Python do ambiente do projeto (.venv/) criado pelo instalar.sh.
# Antes de abrir, confere e conserta sozinho: biblioteca do Python faltando
# e motor C++ desatualizado.
#
# Se o código do motor (C++) mudou depois da última compilação — por
# exemplo, depois de um `git pull` — recompila sozinho antes de abrir.
# Assim nunca roda um motor velho com código novo.
# ---------------------------------------------------------------------------
set -euo pipefail
cd "$(dirname "$0")"

if [ ! -x .venv/bin/python ] || ! ls build/genesis_motor*.so >/dev/null 2>&1; then
    echo "O Genesis ainda não foi instalado. Rode primeiro: ./instalar.sh"
    exit 1
fi

# Biblioteca do Python faltando (ex.: depois de um `git pull` que trocou
# a interface)? Instala sozinho no ambiente do projeto.
if ! .venv/bin/python -c "import pygame" >/dev/null 2>&1; then
    echo "Instalando bibliotecas do Python que faltam..."
    .venv/bin/pip install --quiet --upgrade pybind11 pygame
fi

MODULO="$(ls build/genesis_motor*.so | head -n 1)"
# Algum arquivo do motor ou da receita de compilação é mais novo que o módulo?
if [ -n "$(find motor CMakeLists.txt -newer "$MODULO" -type f | head -n 1)" ]; then
    echo "O motor mudou. Recompilando..."
    cmake --build build -j
fi

exec .venv/bin/python interface/principal.py "$@"
